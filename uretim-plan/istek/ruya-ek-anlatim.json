    "similarity_boost": 0.8,
    "style": 0.3
   }
  },
  {
   "out": "gelen/ruya/b07/x13_0_NARRATOR.mp3",
   "voice": "Brian",
   "lang": "en",
   "text": "Two nights left. And the stars were watching.",
