    "similarity_boost": 0.8,
    "style": 0.3
   }
  },
  {
   "out": "gelen/ruya/b05/x07_0_NARRATOR.mp3",
   "voice": "Brian",
   "lang": "en",
   "text": "Some songs stay with you, even when you forget the words.",
