    "stability": 0.45,
    "similarity_boost": 0.8,
    "style": 0.3
   }
  },
  {
   "out": "gelen/ruya/b05/x04_0_NARRATOR.mp3",
   "voice": "Brian",
   "lang": "en",
   "text": "Somewhere, a music box was playing.",
