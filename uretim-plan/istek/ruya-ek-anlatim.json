    "stability": 0.45,
    "similarity_boost": 0.8,
    "style": 0.3
   }
  },
  {
   "out": "gelen/ruya/b08/x07_0_NARRATOR.mp3",
   "voice": "Brian",
   "lang": "en",
   "text": "Theo was scared. He stayed anyway. That's what friends do.",
