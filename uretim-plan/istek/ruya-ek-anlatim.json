    "stability": 0.45,
    "similarity_boost": 0.8,
    "style": 0.3
   }
  },
  {
   "out": "gelen/ruya/b06/x06_0_NARRATOR.mp3",
   "voice": "Brian",
   "lang": "en",
   "text": "Mira knew that look. She had been afraid too.",
