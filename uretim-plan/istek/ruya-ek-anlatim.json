    "stability": 0.45,
    "similarity_boost": 0.8,
    "style": 0.3
   }
  },
  {
   "out": "gelen/ruya/b07/x03_0_NARRATOR.mp3",
   "voice": "Brian",
   "lang": "en",
   "text": "The attic smelled of old paper and forgotten winters.",
